PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://ccg_user:ccg_password@localhost:5432/cloud_cost_guardian
AWS_REGION=ap-south-1
DEMO_MODE=true
DRY_RUN_DEFAULT=true
IDLE_CPU_THRESHOLD=5.0
LOOKBACK_DAYS=14

# --- TO RUN ON YOUR REAL AWS ACCOUNT ---
# 1. Change DEMO_MODE=false above
# 2. Uncomment and fill in your IAM user credentials below (or run `aws configure`):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
